# Normally generated once by make collab-install. Never commit actual runtime.env/secrets.
COLLAB_ROOT=/srv/pydicate-studio
COLLAB_WORKSPACE=/srv/pydicate-studio/workspace
COLLAB_DATA_DIR=/srv/pydicate-studio/data
COLLAB_ENV_FILE=/srv/pydicate-studio/config/runtime.env
COLLAB_PUBLIC_URL=https://studio.academiatupi.com
COLLAB_AI_ENABLED=0
APP_RELEASE=development
COLLAB_EDGE_NETWORK=caddy_edge
SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@academiatupi.com
SMTP_FROM_NAME=Pydicate Studio — Academia Tupi
COLLAB_SMTP_NETWORK=

# Optional single-account login. Needs the separate Neo identity PR/configuration.
COLLAB_NEO_SSO_ENABLED=0
COLLAB_NEO_ISSUER=https://api.academiatupi.com
COLLAB_NEO_SECRET_FILE=/run/secrets/neo_identity_secret
COLLAB_DIGEST_MODE=off
