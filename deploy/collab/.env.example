COLLAB_PUBLIC_URL=https://studio.academiatupi.com
COLLAB_WORKSPACE=/srv/pydicate-workspace
# Direct authenticated SMTP option. Reuse settings, never commit credentials.
SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@academiatupi.com
SMTP_FROM_NAME=Pydicate Studio — Academia Tupi
# Only needed with relay.compose.yml. Inspect the existing Compose network first.
COLLAB_SMTP_NETWORK=
