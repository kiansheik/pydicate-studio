{
  "name": "pydicate-studio",
  "version": "0.1.0",
  "private": true,
  "description": "A reading and authoring desk for Old Tupi and Pydicate.",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:desktop": "node --test electron/tests/*.test.cjs",
    "test:python": "python3 -B -m unittest discover -s python/tests -v",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run build && npm test && npm run test:desktop && npm run test:python",
    "test:smoke": "node scripts/smoke-desktop.mjs",
    "format": "prettier --write src tests electron scripts *.ts *.json *.html",
    "format:check": "prettier --check src tests electron scripts *.ts *.json *.html"
  },
  "dependencies": {
    "lucide-react": "0.475.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "^41.0.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
