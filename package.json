{
  "name": "pydicate-studio",
  "version": "0.2.0",
  "private": true,
  "description": "Collaborative browser editor for Old Tupi and Pydicate.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "node server/start.cjs",
    "collab": "node server/start.cjs",
    "collab:admin": "node server/admin.cjs",
    "test:collab": "node --test server/tests/*.test.cjs",
    "build": "tsc -b && vite build && node scripts/build-runtime.mjs",
    "docs:build": "python3 -B scripts/build-learning.py",
    "docs:check": "python3 -B scripts/build-learning.py --check",
    "test:learning": "playwright test --config playwright.learning.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:python": "python3 -B -m unittest discover -s python/tests -v",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run build && npm test && npm run test:runtime && npm run test:python && npm run test:ops && npm run test:collab",
    "test:codex-tools": "node scripts/check-codex-tools.mjs",
    "format": "prettier --write src tests runtime scripts *.ts *.json *.html",
    "format:check": "prettier --check src tests runtime scripts *.ts *.json *.html",
    "doctor": "python3 -B scripts/check-project.py",
    "audit:araujo": "python3 -B python/audit_araujo.py",
    "eval:authoring:build": "python3 -B scripts/build-authoring-eval.py",
    "parser-lab": "python3 -B scripts/parser-lab/cli.py",
    "test:runtime": "node --test runtime/tests/*.test.cjs",
    "test:ops": "python3 -B -m unittest discover -s scripts/collab/tests -v"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.100",
    "lucide-react": "0.475.0",
    "pdfjs-dist": "5.4.624",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kiansheik/pydicate-studio.git"
  },
  "homepage": "https://github.com/kiansheik/pydicate-studio",
  "author": "Kian Sheik"
}
