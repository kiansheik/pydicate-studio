{
  "name": "pydicate-studio",
  "version": "0.2.0",
  "private": true,
  "description": "A reading and authoring desk for Old Tupi and Pydicate.",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "build": "npm run docs:build && tsc -b && vite build",
    "docs:build": "python3 -B scripts/build-learning.py",
    "docs:check": "python3 -B scripts/build-learning.py --check",
    "test:learning": "playwright test --config playwright.learning.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:desktop": "node --test electron/tests/*.test.cjs",
    "test:python": "python3 -B -m unittest discover -s python/tests -v",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run build && npm test && npm run test:desktop && npm run test:python",
    "test:smoke": "node scripts/smoke-next.mjs",
    "test:smoke:analysis": "node scripts/smoke-analysis.mjs",
    "test:codex-tools": "node scripts/check-codex-tools.mjs",
    "mcp:analysis": "node scripts/studio-external-analysis.mjs",
    "format": "prettier --write src tests electron scripts *.ts *.json *.html",
    "format:check": "prettier --check src tests electron scripts *.ts *.json *.html",
    "doctor": "python3 -B scripts/check-project.py",
    "audit:araujo": "python3 -B python/audit_araujo.py",
    "eval:authoring:build": "python3 -B scripts/build-authoring-eval.py",
    "test:smoke:example": "node scripts/smoke-desktop.mjs",
    "usage": "node scripts/usage-report.cjs",
    "test:session": "node scripts/smoke-session.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.100",
    "lucide-react": "0.475.0",
    "pdfjs-dist": "5.4.624",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "^41.0.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
